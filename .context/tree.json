    "data/processed": {
      "role": "silver_gold_storage",
      "prio": "p3",
      "crawl": false
    },
    "data/sandbox": {
      "role": "sandbox",
      "prio": "p3",
      "crawl": false
    },
    "schemas": {
      "role": "data_contracts",
      "prio": "p1",
      "crawl": true
    },
    "scripts": {
      "role": "ops_automation",
      "prio": "p2",
      "crawl": true
    },
    "tests": {
      "role": "test_suites",
      "prio": "p1",
      "crawl": true
    },
    "tools": {
      "role": "tooling",
      "prio": "p2",
      "crawl": true
    },
    "logs": {
      "role": "logs",
      "prio": "p3",
      "crawl": false
    },
    ".context": {
      "role": "context_engineering",
      "prio": "p0",
      "crawl": true,
      "key_files": [
        "tree.json"
      ]
