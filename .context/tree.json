{
  "$schema": "./schema/tree.schema.json",
  "version": "3.0",
  "project": "iDirectory",
  "architecture": "Gravity HyperScale Thinking",
  "bootloader": [
    "AGENTS.md",
    ".context/tree.json",
    "01_seed/seed-idirectory-master.md"
  ],
  "nodes": {
    "01_seed": {
      "role": "dna",
      "prio": "p0",
